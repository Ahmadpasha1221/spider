{
  "name": "spider",
  "displayName": "Spider",
  "version": "0.1.0",
  "publisher": "Ahmadpasha1221",
  "description": "An autonomous AI coding agent for VS Code. Use your own model through Ollama, OpenAI-compatible servers, OpenRouter, or Cursor agents, with workspace tools, permissions, streaming, planning, and verification.",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22.13"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "coding",
    "agent",
    "code assistant",
    "ollama",
    "openrouter",
    "openai",
    "local ai",
    "cursor"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#7C3AED",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited"
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:spider.agent",
    "onCommand:spider.openAgent",
    "onCommand:spider.openAgentEditor",
    "onCommand:spider.openSettings",
    "onCommand:spider.openHistory",
    "onChatParticipant:spider.spider"
  ],
  "authentication": {
    "providers": [
      {
        "id": "spider",
        "label": "Spider",
        "supportsMultipleAccounts": false
      }
    ]
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spider",
          "title": "Spider",
          "icon": "assets/spider-icon.png"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "spider.spider",
        "name": "spider",
        "fullName": "Spider",
        "description": "Autonomous AI coding agent for your VS Code workspace.",
        "isSticky": true,
        "commands": [
          {
            "name": "explain",
            "description": "Explain selected code"
          },
          {
            "name": "fix",
            "description": "Fix issues in selection"
          },
          {
            "name": "test",
            "description": "Generate tests"
          }
        ]
      }
    ],
    "configuration": {
      "title": "Spider",
      "properties": {
        "spider.model": {
          "type": "string",
          "default": "",
          "description": "Model used by the Spider agent."
        },
        "spider.autoApply": {
          "type": "boolean",
          "default": false,
          "description": "Automatically apply edits from the agent."
        },
        "spider.execution.shell": {
          "type": "string",
          "default": "",
          "description": "Override the shell Spider uses to run commands. One of powershell, cmd, bash, zsh, sh. Empty auto-detects from the VS Code integrated terminal shell and the workspace environment."
        },
        "spider.execution.wslDistro": {
          "type": "string",
          "default": "",
          "description": "Override the WSL distro Spider runs commands in when the workspace is inside WSL. Empty uses the distro reported by VS Code / the workspace path."
        },
        "spider.rules.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Load .spiderrules files from the workspace and inject them as project instructions in the agent's system prompt. Nested rules apply under their directory; root rules apply everywhere."
        }
      }
    },
    "views": {
      "spider": [
        {
          "type": "webview",
          "id": "spider.agent",
          "name": "Agent",
          "icon": "assets/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "spider.openAgent",
        "title": "Open Agent",
        "category": "Spider"
      },
      {
        "command": "spider.openAgentEditor",
        "title": "Open Agent Editor",
        "category": "Spider"
      },
      {
        "command": "spider.openSettings",
        "title": "Open Settings",
        "category": "Spider"
      },
      {
        "command": "spider.openHistory",
        "title": "Open History",
        "category": "Spider"
      }
    ]
  },
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.gui.json --noEmit",
    "lint": "eslint src test gui --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:vsix": "node scripts/vsixSmokeTest.mjs",
    "test:integration": "vscode-test",
    "vscode:prepublish": "pnpm run typecheck && pnpm run lint && pnpm run compile",
    "package": "pnpm run vscode:prepublish && node scripts/stage-vsix.js"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.35",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/dompurify": "^3.2.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.13.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@typescript-eslint/utils": "^8.22.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.15.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.4.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ahmadpasha1221/spider"
  },
  "bugs": {
    "url": "https://github.com/Ahmadpasha1221/spider/issues"
  },
  "homepage": "https://github.com/Ahmadpasha1221/spider#readme"
}
